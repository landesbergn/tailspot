{
  "name": "tailspot-content-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Daily short-form carousel generator for Tailspot (real ADS-B data only).",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "generate": "NODE_USE_ENV_PROXY=1 node --experimental-strip-types --no-warnings=ExperimentalWarning src/cli.ts",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test test/*.test.ts"
  },
  "dependencies": {
    "playwright": "1.56.1"
  }
}
