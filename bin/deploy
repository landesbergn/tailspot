#!/usr/bin/env bash
# bin/deploy [--no-build] [--no-launch] [--dry-run]
#
# Build the Tailspot iOS app for Noah's iPhone, install it over the
# CoreDevice wireless link, and launch the app. Idempotently ensures
# bin/log-start is running so device-side logs are captured to
# $TAILSPOT_LOG_FILE for bin/log-tail to inspect.
#
# Exits non-zero on any step failure; stderr is preserved.

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$here/tools/deploy/config.sh"

do_build=1
do_launch=1
dry_run=0
while [ $# -gt 0 ]; do
  case "$1" in
    --no-build) do_build=0; shift ;;
    --no-launch) do_launch=0; shift ;;
    --dry-run) dry_run=1; shift ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

run() {
  if [ "$dry_run" -eq 1 ]; then
    echo "DRY: $*"
  else
    echo "+ $*"
    "$@"
  fi
}

# Step 0: ensure log stream is running (idempotent).
if [ "$dry_run" -eq 1 ]; then
  echo "DRY: bin/log-start"
else
  "$here/bin/log-start"
fi

# Step 0.5: PostHog secrets backstop. The key lives in a GITIGNORED xcconfig,
# so a fresh per-feature worktree doesn't have it — and a keyless build
# silently no-ops ALL analytics + session replay (Analytics.swift's designed
# keyless mode). That silence cost 6 days of dark telemetry from the dev
# phone (2026-08-19 → 08-25: every worktree deploy was keyless). Heal it
# from the primary checkout when possible; otherwise warn LOUDLY and build
# keyless anyway (keyless is still a valid build, just not silently).
secrets_rel="ios/Tailspot/Tailspot.secrets.xcconfig"
if [ ! -f "$here/$secrets_rel" ]; then
  common_dir="$(cd "$here" && git rev-parse --git-common-dir 2>/dev/null || true)"
  primary="$(dirname "$common_dir")"
  if [ -n "$common_dir" ] && [ -f "$primary/$secrets_rel" ]; then
    if [ "$dry_run" -eq 1 ]; then
      echo "DRY: cp $primary/$secrets_rel $here/$secrets_rel"
    else
      cp "$primary/$secrets_rel" "$here/$secrets_rel"
      echo "NOTE: copied gitignored $secrets_rel from primary checkout ($primary) — worktrees don't carry it"
    fi
  else
    echo "" >&2
    echo "##################################################################" >&2
    echo "# WARNING: $secrets_rel missing — this build is KEYLESS:         " >&2
    echo "# PostHog analytics + session replay will silently NO-OP on the  " >&2
    echo "# device. Copy the file from the primary checkout if you want    " >&2
    echo "# telemetry from this build.                                     " >&2
    echo "##################################################################" >&2
    echo "" >&2
  fi
fi

# TAILSPOT_BUILD_DIR is absolute (see config.sh: outside iCloud-synced
# Desktop so codesign doesn't choke on fileprovider xattrs).
app_path="$TAILSPOT_BUILD_DIR/Build/Products/Debug-iphoneos/Tailspot.app"

# Step 1: build (optional).
if [ "$do_build" -eq 1 ]; then
  run xcodebuild build \
    -project "$here/$TAILSPOT_PROJECT" \
    -scheme "$TAILSPOT_SCHEME" \
    -destination "platform=iOS,id=$TAILSPOT_DEVICE_ID" \
    -derivedDataPath "$TAILSPOT_BUILD_DIR"
fi

if [ "$dry_run" -eq 0 ] && [ ! -d "$app_path" ]; then
  echo "expected .app not found at $app_path" >&2
  exit 1
fi

# Step 2: install.
run xcrun devicectl device install app \
  --device "$TAILSPOT_DEVICE_ID" \
  "$app_path"

# Step 3: launch (optional). The app gets ADS-B solely from the Tailspot
# backend now (no per-app secret), so the launch environment is clean — no
# credential injection, no scheme-scraping.
if [ "$do_launch" -eq 1 ]; then
  if [ "$dry_run" -eq 1 ]; then
    echo "DRY: xcrun devicectl device process launch --device $TAILSPOT_DEVICE_ID $TAILSPOT_BUNDLE_ID"
  else
    run xcrun devicectl device process launch \
      --device "$TAILSPOT_DEVICE_ID" \
      "$TAILSPOT_BUNDLE_ID"
  fi
fi

echo "deployed; log at $TAILSPOT_LOG_FILE"
