#!/usr/bin/env bash
# SessionStart hook for Claude Code cloud sessions (claude.ai/code).
#
# Local sessions: exits immediately (CLAUDE_CODE_REMOTE is only "true" inside
# the cloud VM), so this costs nothing on the Mac.
#
# Cloud sessions: probes the read-only observability credentials and prints
# one status line into Claude's context (a SessionStart hook's stdout is added
# to context), so the session knows up front which sources it can read. The
# rules live only in CLAUDE.md "Cloud sessions" and docs/observability.md.
#
# Must always exit 0 and always print.

[ "${CLAUDE_CODE_REMOTE:-}" = "true" ] || exit 0

repo_root="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}"
creds=$(OBS_TIMEOUT=15 "$repo_root/bin/obs" check 2>&1 | sed 's/: .*//' | paste -sd ',' - | sed 's/,/, /g')

echo "Cloud observability session (claude.ai/code): read-only PostHog/Sentry/Fly via bin/obs, no macOS, no deploys. Credentials: ${creds:-check failed to run}. Follow CLAUDE.md \"Cloud sessions\" and docs/observability.md."
exit 0
