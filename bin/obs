#!/usr/bin/env bash
# Read-only observability helpers: PostHog, Sentry, Fly over plain REST.
#
# In a cloud session (claude.ai/code) no credential is ever in the VM: each
# request goes out WITHOUT an Authorization header and the environment's
# network secrets attach the read-only key in the egress proxy. Locally, set
# POSTHOG_PERSONAL_API_KEY / SENTRY_AUTH_TOKEN / FLY_API_TOKEN to use it from
# the Mac; unset means "let the proxy add it".
#
# The keys' scopes are what make this read-only (see docs/observability.md);
# the script also only ever issues GETs, plus the PostHog query POST.
#
#   bin/obs check                      probe all three credentials
#   bin/obs posthog-sql "<HogQL>"      run a HogQL query (project 466448)
#   bin/obs posthog <path>             GET /api/projects/466448/<path>
#   bin/obs sentry <path>              GET https://sentry.io/api/0/<path>
#   bin/obs fly-machines <app>         machine id/state/region/image/updated
#   bin/obs fly-logs <app> [token]     recent log lines (pass next_token to page)
#   bin/obs fly <path>                 GET https://api.machines.dev/v1/<path>
#
# Fly apps: tailspot-api, tailspot-www, tailspot-www-preview, tailspot-db.

set -euo pipefail

POSTHOG="https://us.posthog.com/api/projects/466448"
SENTRY="https://sentry.io/api/0"
SENTRY_ORG="noah-lc"
FLY_API="https://api.fly.io/api/v1"
FLY_MACHINES="https://api.machines.dev/v1"

# set_auth <env-var> <scheme>: fills AUTH with a curl -H pair when the local
# variable is set, else leaves it empty for the proxy to fill in.
set_auth() {
  AUTH=()
  local value="${!1:-}"
  [ -z "$value" ] && return 0
  case "$value" in "$2 "*) ;; *) value="$2 $value" ;; esac
  AUTH=(-H "Authorization: $value")
}

# req <env-var> <scheme> <curl args...>. The ${AUTH[@]+...} form keeps an
# empty array safe under set -u on macOS's bash 3.2.
req() {
  set_auth "$1" "$2"; shift 2
  curl -sS --fail-with-body -m "${OBS_TIMEOUT:-60}" ${AUTH[@]+"${AUTH[@]}"} "$@"
}

posthog_get()  { req POSTHOG_PERSONAL_API_KEY Bearer "$POSTHOG/$1"; }
# {noah} in a query becomes Noah's quoted person_id, so callers can single-quote
# HogQL (keeping $app_build etc. away from the shell). Unset is an error, never
# a silent `person_id != ''` that excludes nobody.
posthog_sql()  {
  local q="$1"
  case "$q" in *"{noah}"*)
    [ -n "${TAILSPOT_NOAH_PERSON_ID:-}" ] ||
      { echo "obs: {noah} used but TAILSPOT_NOAH_PERSON_ID is unset (set it in the environment)" >&2; return 2; }
    # Via a variable: bash 3.2 keeps backslashes from an inline \' replacement.
    local pattern="{noah}" quoted="'$TAILSPOT_NOAH_PERSON_ID'"
    q="${q//"$pattern"/$quoted}" ;;
  esac
  req POSTHOG_PERSONAL_API_KEY Bearer -H "Content-Type: application/json" \
    -d "$(jq -nc --arg q "$q" '{query: {kind: "HogQLQuery", query: $q}}')" "$POSTHOG/query/"
}

# then_jq <filter> <command...>: runs the command and pipes its JSON through
# jq on success; on failure prints the raw error body instead of jq'ing it.
then_jq() {
  local filter="$1" out; shift
  if out=$("$@"); then jq "${JQ_FLAGS[@]+"${JQ_FLAGS[@]}"}" "$filter" <<<"$out"
  else local rc=$?; printf '%s\n' "$out" >&2; return "$rc"; fi
}
sentry_get()   { req SENTRY_AUTH_TOKEN Bearer "$SENTRY/$1"; }
# Fly's logs endpoint only accepts the "FlyV1 <token>" scheme (Bearer gets a
# 401); the Machines API takes either. `fly tokens create readonly` already
# prints the token in FlyV1 form.
fly_api_get()  { req FLY_API_TOKEN FlyV1 "$FLY_API/$1"; }
fly_mach_get() { req FLY_API_TOKEN FlyV1 "$FLY_MACHINES/$1"; }

probe() {  # probe <label> <command...>
  local out
  if out=$("${@:2}" 2>&1); then echo "$1 ok"
  else echo "$1 FAILED: $(printf '%s' "$out" | tr '\n' ' ' | cut -c1-140)"; fi
}

JQ_FLAGS=()
cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  check)
    probe posthog      posthog_sql "select 1"
    probe sentry       sentry_get "organizations/$SENTRY_ORG/projects/"
    probe fly-machines fly_mach_get "apps/tailspot-api/machines"
    probe fly-logs     fly_api_get "apps/tailspot-api/logs"
    ;;
  # hasMore=true means HogQL's default LIMIT truncated the rows.
  posthog-sql)  then_jq '{columns, results, hasMore}' posthog_sql "${1:?HogQL query}" ;;
  posthog)      posthog_get "${1:?path}" ;;
  sentry)       sentry_get "${1:?path}" ;;
  fly)          fly_mach_get "${1:?path}" ;;
  fly-machines)
    JQ_FLAGS=(-c); then_jq '.[] | {id, state, region, updated_at, image: .config.image}' \
      fly_mach_get "apps/${1:?app}/machines"
    ;;
  fly-logs)
    page=""
    [ -n "${2:-}" ] && page="?next_token=$(jq -rn --arg t "$2" '$t | @uri')"
    JQ_FLAGS=(-r); then_jq '(.data[].attributes | "\(.timestamp) \(.region) \(.level) \(.message)"), "next_token: \(.meta.next_token)"' \
      fly_api_get "apps/${1:?app}/logs$page"
    ;;
  *) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
